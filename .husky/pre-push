npx lint-staged --version >/dev/null 2>&1 || {
  echo "lint-staged is not available. Run your package install before pushing."
  exit 1
}

zero_sha="0000000000000000000000000000000000000000"
status=0
has_push_ref=0

while read -r local_ref local_sha remote_ref remote_sha
do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  has_push_ref=1

  if [ "$remote_sha" = "$zero_sha" ]; then
    diff_range="HEAD~1...HEAD"
  else
    diff_range="$remote_sha...$local_sha"
  fi

  echo "Running lint-staged for $local_ref -> $remote_ref ($diff_range)"
  npx lint-staged --diff="$diff_range" || status=$?
done

if [ "$status" -ne 0 ]; then
  exit "$status"
fi

if [ "$has_push_ref" -eq 0 ]; then
  exit 0
fi

echo "Running frontend production build"
pnpm -C frontend build || exit $?

echo "Running backend production build"
pnpm -C backend build || exit $?

exit "$status"
