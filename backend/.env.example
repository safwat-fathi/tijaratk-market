# App URL
APP_URL=
APP_RELEASE=

HTTP_SERVER_PORT=

# Data base
DB_URL=
MIGRATE_DB_URL=
SEED_DB_URL=
SHADOW_DATABASE_URL=

JWT_SECRET=

# Admin credentials
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Admin-managed merchant operations (disabled unless explicitly true)
ADMIN_MANAGED_STORES_ENABLED=false
ADMIN_PRODUCT_WRITE_ENABLED=false
ADMIN_ORDER_WRITE_ENABLED=false
ADMIN_BULK_PRODUCT_UPDATE_ENABLED=false
ADMIN_MANAGEMENT_SESSION_IDLE_MINUTES=45
ADMIN_MANAGEMENT_SESSION_MAX_HOURS=8

# Central zone storefront discovery and new checkout (disabled by default)
ZONE_STOREFRONTS_ENABLED=false

ENCRYPTION_PASSWORD=

# Web Push notifications (generate one VAPID pair and keep it stable)
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:info@tijaratk.com

CLIENT_URL=

# Google Analytics 4 Measurement Protocol (disabled unless both are present)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Meta Conversions API (disabled unless every required value is present)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Explicitly version API calls; v23.0 is the initial rollout example
META_GRAPH_API_VERSION=v23.0
# Enable only while validating events in Meta Events Manager
META_CAPI_TEST_EVENT_CODE=
# Shared HMAC secret; use the same value in the Next.js frontend
META_CONTEXT_SIGNING_SECRET=

CORS_ALLOWED_ORIGINS=

# Twilio
ACCOUNT_SID=
AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
WHATSAPP_PHONE_NUMBER=
WHATSAPP_NOTIFICATIONS_ENABLED=
# Optional public webhook origin override; falls back to APP_URL
WEBHOOK_PUBLIC_BASE_URL=

# Twilio Content SID
TWILIO_CONTENT_SID_ORDER_RECEIVED_CUSTOMER=
TWILIO_CONTENT_SID_ORDER_OUT_FOR_DELIVERY=
TWILIO_CONTENT_SID_ORDER_STATUS_UPDATE_CUSTOMER=
TWILIO_CONTENT_SID_NEW_ORDER_MERCHANT=
TWILIO_CONTENT_SID_MERCHANT_REPLACEMENT_REJECTED=
TWILIO_CONTENT_SID_MERCHANT_REPLACEMENT_ACCEPTED=
TWILIO_CONTENT_SID_ORDER_PRODUCT_REPLACEMENT=
TWILIO_CONTENT_SID_MERCHANT_DAY_CLOSURE_SUMMARY=
TWILIO_CONTENT_SID_ZONE_ORDER_OPERATIONS=
TWILIO_CONTENT_SID_ZONE_ORDER_ASSIGNED=
TWILIO_CONTENT_SID_ZONE_DISPATCH_REJECTED_OPERATIONS=
TWILIO_CONTENT_SID_ZONE_DISPATCH_REASSIGNED_OPERATIONS=
TWILIO_CONTENT_SID_ZONE_ORDER_ACCEPTED_CUSTOMER=

SEED_SUPERMARKET_OWNER_CREDENTIAL=

# Sentry
SENTRY_DSN=
