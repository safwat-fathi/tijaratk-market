}

model ImportRun {
  id                 Int              @id @default(autoincrement())
  type               ImportType
  mode               ImportMode       @default(upsert)
  status             ImportStatus     @default(pending)
  original_file_name String           @db.VarChar
  file_path          String?          @db.VarChar
  total_rows         Int              @default(0)
  processed_rows     Int              @default(0)
  success_rows       Int              @default(0)
  failed_rows        Int              @default(0)
  created_rows       Int              @default(0)
  updated_rows       Int              @default(0)
  skipped_rows       Int              @default(0)
  error_message      String?
  started_at         DateTime?        @db.Timestamp(6)
  finished_at        DateTime?        @db.Timestamp(6)
  created_at         DateTime         @default(now()) @db.Timestamp(6)
  updated_at         DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  errors             ImportRowError[]

  @@index([type, status, created_at], map: "IDX_import_runs_type_status_created_at")
  @@map("import_runs")
}

model ImportRowError {
  id            Int       @id @default(autoincrement())
  import_run_id Int
  row_number    Int
  row_data      Json
  error_code    String?   @db.VarChar(64)
  error_message String
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  import_run    ImportRun @relation(fields: [import_run_id], references: [id], onDelete: Cascade)

  @@index([import_run_id], map: "IDX_import_row_errors_import_run_id")
  @@map("import_row_errors")
}

