/// Cross-tenant dispatch state for one operator-owned zone order.
model OrderDispatch {
  id                    Int                 @id @default(autoincrement())
  order_id              Int                 @unique(map: "UQ_order_dispatches_order_id")
  zone_storefront_id    Int
  status                OrderDispatchStatus @default(pending)
  version               Int                 @default(0)
  cancellation_reason   String?
  cancelled_by_admin_id Int?
  cancelled_at          DateTime?           @db.Timestamptz(6)
  accepted_at           DateTime?           @db.Timestamptz(6)
  created_at            DateTime            @default(now()) @db.Timestamp(6)
  updated_at            DateTime            @default(now()) @updatedAt @db.Timestamp(6)

  order              Order                       @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_order_dispatches_order")
  zone_storefront    ZoneStorefront              @relation(fields: [zone_storefront_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_order_dispatches_zone")
  cancelled_by_admin AdminUser?                   @relation("OrderDispatchCancellingAdmin", fields: [cancelled_by_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_order_dispatches_cancelled_by_admin")
  assignments        OrderDispatchAssignment[]

  @@index([zone_storefront_id, status, created_at(sort: Desc)], map: "IDX_order_dispatches_zone_status_created")
  @@map("order_dispatches")
}

/// Append-only merchant assignment attempt. Only state and response metadata are updated.
model OrderDispatchAssignment {
  id                    Int                           @id @default(autoincrement())
  order_dispatch_id     Int
  target_tenant_id      Int
  assigned_by_admin_id  Int
  responded_by_user_id  Int?
  status                OrderDispatchAssignmentStatus @default(pending)
  is_current            Boolean                       @default(true)
  version               Int                           @default(0)
  reason                String?
  internal_notes        String?
  assigned_at           DateTime                      @default(now()) @db.Timestamptz(6)
  responded_at          DateTime?                     @db.Timestamptz(6)
  created_at            DateTime                      @default(now()) @db.Timestamp(6)
  updated_at            DateTime                      @default(now()) @updatedAt @db.Timestamp(6)

  order_dispatch    OrderDispatch @relation(fields: [order_dispatch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_order_dispatch_assignments_dispatch")
  target_tenant     Tenant        @relation("OrderDispatchAssignmentTargetTenant", fields: [target_tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_order_dispatch_assignments_target_tenant")
  assigned_by_admin AdminUser     @relation("OrderDispatchAssignmentAssigningAdmin", fields: [assigned_by_admin_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_order_dispatch_assignments_assigning_admin")
  responded_by_user User?         @relation("OrderDispatchAssignmentRespondingUser", fields: [responded_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_order_dispatch_assignments_responding_user")
  quote_lines       OrderDispatchQuoteLine[]

  @@unique([order_dispatch_id], map: "UQ_order_dispatch_assignments_current_dispatch", where: raw("(is_current = true)"))
  @@index([target_tenant_id, status, is_current, assigned_at(sort: Desc)], map: "IDX_order_dispatch_assignments_target_status_current")
  @@index([order_dispatch_id, created_at], map: "IDX_order_dispatch_assignments_dispatch_created")
  @@map("order_dispatch_assignments")
}

/// Assignment-scoped price proposal that is applied to order snapshots only when accepted.
model OrderDispatchQuoteLine {
  id              Int      @id @default(autoincrement())
  assignment_id   Int
  order_item_id   Int
  unit_price      Decimal  @db.Decimal(10, 2)
  total_price     Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(6)

  assignment OrderDispatchAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_order_dispatch_quote_lines_assignment")
  order_item OrderItem               @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_order_dispatch_quote_lines_order_item")

  @@unique([assignment_id, order_item_id], map: "UQ_order_dispatch_quote_lines_assignment_item")
  @@index([order_item_id], map: "IDX_order_dispatch_quote_lines_order_item")
  @@map("order_dispatch_quote_lines")
}

model AdminTenantAccess {
  id                    Int       @id @default(autoincrement())
  admin_user_id         Int
  tenant_id             Int
  permissions           Json      @db.JsonB
  is_active             Boolean   @default(true)
  granted_by_admin_id   Int?
  granted_at            DateTime  @default(now()) @db.Timestamptz(6)
  expires_at            DateTime? @db.Timestamptz(6)
  revoked_at            DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  admin_user             AdminUser  @relation("AdminTenantAccessAdmin", fields: [admin_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_admin_tenant_accesses_admin_user")
  tenant                 Tenant     @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_admin_tenant_accesses_tenant")
  granted_by_admin       AdminUser? @relation("AdminTenantAccessGrantedBy", fields: [granted_by_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_admin_tenant_accesses_granted_by")
  management_sessions    AdminManagementSession[]

  @@unique([admin_user_id, tenant_id], map: "UQ_admin_tenant_accesses_admin_tenant")
  @@index([tenant_id, is_active], map: "IDX_admin_tenant_accesses_tenant_active")
  @@index([admin_user_id, is_active], map: "IDX_admin_tenant_accesses_admin_active")
  @@map("admin_tenant_accesses")
}

model AdminManagementSession {
  id                 Int       @id @default(autoincrement())
  session_token_hash String    @unique(map: "UQ_admin_management_sessions_token_hash") @db.Char(64)
  admin_user_id      Int
  tenant_id          Int
  access_id          Int
  reason             String    @db.VarChar(500)
  started_at         DateTime  @default(now()) @db.Timestamptz(6)
  last_active_at     DateTime  @default(now()) @db.Timestamptz(6)
  expires_at         DateTime  @db.Timestamptz(6)
  ended_at           DateTime? @db.Timestamptz(6)
  end_reason         AdminManagementSessionEndReason?
  ip_address         String?   @db.VarChar(64)
  user_agent         String?   @db.VarChar(512)
  created_at         DateTime  @default(now()) @db.Timestamp(6)

  admin_user         AdminUser         @relation(fields: [admin_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_admin_management_sessions_admin_user")
  tenant             Tenant            @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_admin_management_sessions_tenant")
  access             AdminTenantAccess @relation(fields: [access_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_admin_management_sessions_access")
  activity_logs      ActivityLog[]
  admin_audit_logs   AdminAuditLog[]

  @@unique([admin_user_id], map: "UQ_admin_management_sessions_one_active_admin", where: raw("(ended_at IS NULL)"))
  @@index([tenant_id, started_at(sort: Desc)], map: "IDX_admin_management_sessions_tenant_started")
  @@index([admin_user_id, ended_at], map: "IDX_admin_management_sessions_admin_ended")
  @@map("admin_management_sessions")
}

/// Platform control-plane audit trail. This table intentionally does not use tenant RLS.
model AdminAuditLog {
  id                        Int                  @id @default(autoincrement())
  actor_admin_id            Int?
  actor_admin_name_snapshot String?              @db.VarChar(160)
  actor_admin_role_snapshot AdminRole?
  tenant_id                 Int?
  management_session_id     Int?
  entity_type               AdminAuditEntityType?
  entity_id                 Int?
  action                    String               @db.VarChar(96)
  title                     String               @db.VarChar(160)
  outcome                   AdminAuditOutcome    @default(success)
  request_id                String?              @db.VarChar(64)
  ip_address                String?              @db.VarChar(64)
  metadata                  Json?                @db.JsonB
  created_at                DateTime             @default(now()) @db.Timestamptz(6)

  actor_admin       AdminUser?              @relation(fields: [actor_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_admin_audit_logs_actor_admin")
  tenant            Tenant?                 @relation(fields: [tenant_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_admin_audit_logs_tenant")
  management_session AdminManagementSession? @relation(fields: [management_session_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_admin_audit_logs_management_session")

  @@index([created_at(sort: Desc), id(sort: Desc)], map: "IDX_admin_audit_logs_created_id")
  @@index([actor_admin_id, created_at(sort: Desc)], map: "IDX_admin_audit_logs_actor_created")
  @@index([tenant_id, created_at(sort: Desc)], map: "IDX_admin_audit_logs_tenant_created")
  @@index([action, outcome, created_at(sort: Desc)], map: "IDX_admin_audit_logs_action_outcome_created")
  @@index([request_id], map: "IDX_admin_audit_logs_request_id")
  @@map("admin_audit_logs")
}

model SubscriptionPlan {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar
  price      Decimal  @db.Decimal(10, 2)
  features   Json?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  tenant_subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

model TenantSubscription {
  id         Int       @id @default(autoincrement())
  tenant_id  Int
  plan_id    Int
  start_date DateTime  @default(now()) @db.Timestamptz(6)
  end_date   DateTime? @db.Timestamptz(6)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @default(now()) @db.Timestamp(6)

  tenant Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [plan_id], references: [id], onDelete: Restrict)

  @@index([tenant_id])
  @@index([plan_id])
  @@map("tenant_subscriptions")
}

model TenantHiddenCatalogItem {
  tenant_id       Int
  catalog_item_id Int
  created_at      DateTime @default(now()) @db.Timestamp(6)

  tenant       Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  catalog_item CatalogItem @relation(fields: [catalog_item_id], references: [id], onDelete: Cascade)

  @@id([tenant_id, catalog_item_id], map: "PK_tenant_hidden_catalog_items")
  @@index([tenant_id], map: "IDX_tenant_hidden_catalog_items_tenant_id")
  @@map("tenant_hidden_catalog_items")
}
