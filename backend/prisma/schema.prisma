  zone_storefront ZoneStorefront @relation(fields: [zone_storefront_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_zone_storefront_merchants_zone")
  tenant          Tenant         @relation("ZoneStorefrontMerchantTenant", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_zone_storefront_merchants_tenant")

  @@unique([zone_storefront_id, tenant_id], map: "UQ_zone_storefront_merchants_zone_tenant")
  @@index([zone_storefront_id, is_active, priority], map: "IDX_zone_storefront_merchants_zone_active_priority")
  @@index([tenant_id, is_active], map: "IDX_zone_storefront_merchants_tenant_active")
