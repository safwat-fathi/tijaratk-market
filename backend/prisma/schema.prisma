/// Cross-tenant control-plane record for a public zone storefront. This table intentionally does not use tenant RLS.
model ZoneStorefront {
  id                 Int      @id @default(autoincrement())
  area_id            Int
  operator_tenant_id Int      @unique(map: "UQ_zone_storefronts_operator_tenant_id")
  name               String   @db.VarChar(120)
  slug               String   @unique(map: "UQ_zone_storefronts_slug") @db.VarChar(120)
  category           TenantCategory
  operations_phone   String   @db.VarChar(32)
  is_active          Boolean  @default(false)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamp(6)

  area            DirectoryArea              @relation(fields: [area_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_zone_storefronts_area")
  operator_tenant Tenant                     @relation("ZoneStorefrontOperatorTenant", fields: [operator_tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_zone_storefronts_operator_tenant")
  merchants       ZoneStorefrontMerchant[]
  dispatches      OrderDispatch[]

  @@unique([area_id, category], map: "UQ_zone_storefronts_area_category")
  @@index([is_active, slug], map: "IDX_zone_storefronts_active_slug")
  @@map("zone_storefronts")
}

