generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AvailabilityRequest {
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @db.Timestamp(6)
  deleted_at   DateTime? @db.Timestamp(6)
  tenant_id    Int
  id           Int       @id(map: "PK_availability_requests_id") @default(autoincrement())
  product_id             Int?
  visitor_key            String    @db.VarChar(64)
  request_date           DateTime  @db.Date
  requested_product_name String?   @db.VarChar(120)
  requested_product_key  String?   @db.VarChar(120)
  customer_name          String?   @db.VarChar(120)
  customer_phone         String?   @db.VarChar(32)
  customer_address       String?
  customer_notes         String?
  product                Product?  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_availability_requests_product")
  tenant                 Tenant    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_availability_requests_tenant")

  @@unique([tenant_id, product_id, visitor_key, request_date], map: "UQ_availability_requests_tenant_product_visitor_date")
  @@unique([tenant_id, requested_product_key, visitor_key, request_date], map: "UQ_availability_requests_tenant_custom_visitor_date")
  @@index([product_id], map: "IDX_availability_requests_product_id")
  @@index([request_date], map: "IDX_availability_requests_request_date")
  @@index([tenant_id, created_at(sort: Desc)], map: "IDX_availability_requests_tenant_created_at")
  @@index([tenant_id, requested_product_key, request_date], map: "IDX_availability_requests_tenant_custom_request_date")
  @@index([tenant_id, product_id, request_date], map: "IDX_availability_requests_tenant_product_request_date")
  @@index([visitor_key], map: "IDX_availability_requests_visitor_key")
  @@map("availability_requests")
}

model CatalogItem {
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @default(now()) @db.Timestamp(6)
  deleted_at         DateTime? @db.Timestamp(6)
  id                 Int       @id(map: "PK_dd1c29828c10a599d894b9b6535") @default(autoincrement())
  name               String    @db.VarChar
  image_url          String?
  original_image_url String?
  category           String    @db.VarChar
  price              Decimal?  @db.Decimal(10, 2)
  currency           String    @default("EGP") @db.VarChar(3)
  is_active          Boolean   @default(true)
  is_essential       Boolean   @default(false)
  essential_sort_order Int?
  source             String    @default("seed") @db.VarChar(64)
  external_id        String?   @db.VarChar(128)
  last_seen_at       DateTime? @db.Timestamp(6)

  tenant_hidden_catalog_items TenantHiddenCatalogItem[]
  products                    Product[]                @relation("CatalogItemProducts")

  @@unique([source, external_id], map: "UQ_catalog_items_source_external_id")
  @@index([source, is_essential, category], map: "IDX_catalog_items_source_essential_category")
  @@map("catalog_items")
}

model CatalogCategory {
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)
  id         Int       @id(map: "PK_catalog_categories_id") @default(autoincrement())
  source     String    @db.VarChar(64)
  name       String    @db.VarChar(64)
  image_url  String?

  @@unique([source, name], map: "UQ_catalog_categories_source_name")
  @@index([source, deleted_at], map: "IDX_catalog_categories_source_deleted_at")
  @@map("catalog_categories")
}

/// Durable, source-scoped work state for reconciling essential catalog rows
/// into every matching zone operator snapshot. This control-plane table does
/// not use tenant RLS.
model ZoneCatalogReconciliation {
  source                String    @id @db.VarChar(64)
  requested_revision    Int       @default(0)
  completed_revision    Int       @default(0)
  processing_revision   Int?
  processing_started_at DateTime? @db.Timestamptz(6)
  next_attempt_at       DateTime  @default(now()) @db.Timestamptz(6)
  attempt_count         Int       @default(0)
  last_error            String?
  requested_at          DateTime  @default(now()) @db.Timestamptz(6)
  completed_at          DateTime? @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([next_attempt_at], map: "IDX_zone_catalog_reconciliations_next_attempt")
  @@map("zone_catalog_reconciliations")
}

model ImportRun {
  id                 Int              @id @default(autoincrement())
  type               ImportType
  format             String?          @db.VarChar(64)
  mode               ImportMode       @default(upsert)
  status             ImportStatus     @default(pending)
  original_file_name String           @db.VarChar
  file_path          String?          @db.VarChar
  total_rows         Int              @default(0)
  processed_rows     Int              @default(0)
  success_rows       Int              @default(0)
  failed_rows        Int              @default(0)
  created_rows       Int              @default(0)
  updated_rows       Int              @default(0)
  skipped_rows       Int              @default(0)
  error_message      String?
  started_at         DateTime?        @db.Timestamp(6)
  finished_at        DateTime?        @db.Timestamp(6)
  created_at         DateTime         @default(now()) @db.Timestamp(6)
  updated_at         DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  errors             ImportRowError[]

  @@index([type, status, created_at], map: "IDX_import_runs_type_status_created_at")
  @@map("import_runs")
}

model ImportRowError {
  id            Int       @id @default(autoincrement())
  import_run_id Int
  row_number    Int
  row_data      Json
  error_code    String?   @db.VarChar(64)
  error_message String
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  import_run    ImportRun @relation(fields: [import_run_id], references: [id], onDelete: Cascade)

  @@index([import_run_id], map: "IDX_import_row_errors_import_run_id")
  @@map("import_row_errors")
}

