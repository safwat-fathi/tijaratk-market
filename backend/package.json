{
  "name": "tijaratk-backend",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && if [ \"$SENTRY_DISABLE_AUTO_UPLOAD\" != \"true\" ] && [ \"$SENTRY_DISABLE_AUTO_UPLOAD\" != \"1\" ] && [ \"$(git rev-parse --abbrev-ref HEAD 2>/dev/null)\" != \"staging\" ]; then pnpm sentry:sourcemaps; fi",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test:e2e": "pnpm run test:e2e:security",
    "test:e2e:security": "NODE_ENV=development pnpm run build && NODE_ENV=development jest --config test/jest-e2e.json --runInBand",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "db:seed:dev": "NODE_ENV=development ts-node -r tsconfig-paths/register ./src/common/seed.ts",
    "db:seed:prod": "NODE_ENV=production ts-node -r tsconfig-paths/register ./src/common/seed.ts",
    "cli:dev": "NODE_ENV=development ts-node -r tsconfig-paths/register ./src/cli.ts",
    "cli:prod": "NODE_ENV=production ts-node -r tsconfig-paths/register ./src/cli.ts",
    "catalog:cleanup:dev": "NODE_ENV=development ts-node -r tsconfig-paths/register ./src/common/scripts/deactivate-contaminated-catalog-items.ts",
    "catalog:cleanup:prod": "NODE_ENV=production ts-node -r tsconfig-paths/register ./src/common/scripts/deactivate-contaminated-catalog-items.ts",
    "catalog:normalize-grocery:dev": "NODE_ENV=development ts-node -r tsconfig-paths/register ./src/common/scripts/normalize-grocery-catalog-categories.ts",
    "catalog:normalize-grocery:prod": "NODE_ENV=production ts-node -r tsconfig-paths/register ./src/common/scripts/normalize-grocery-catalog-categories.ts",
    "db:migrate:dev": "NODE_ENV=development prisma migrate dev",
    "db:migrate:deploy": "NODE_ENV=production prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:reset:dev": "NODE_ENV=development prisma migrate reset && NODE_ENV=development ts-node -r tsconfig-paths/register ./src/common/scripts/grant-permissions.ts",
    "db:studio:dev": "NODE_ENV=development prisma studio",
    "db:studio:prod": "NODE_ENV=production prisma studio --browser none --port 5555",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org tijaratk --project tijaratk-backend ./dist && sentry-cli sourcemaps upload --org tijaratk --project tijaratk-backend ./dist"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.0",
    "@sentry/cli": "^2.58.6",
    "@sentry/nestjs": "^8.47.0",
    "@sentry/profiling-node": "^8.47.0",
    "@types/sharp": "^0.32.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.2.1",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.35",
    "multer": "^2.0.2",
    "nest-commander": "^3.20.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.17.2",
    "read-excel-file": "^9.3.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/inquirer": "^8.2.13",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  }
}
