NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_BASE_URL=

# Central zone storefronts are disabled unless explicitly true.
ZONE_STOREFRONTS_ENABLED=false

# debug, upload, and Play App Signing certificates. Fingerprints are public.

# Comma-separated SHA-256 fingerprints for the customer Android app's
ANDROID_CUSTOMER_CERT_SHA256_FINGERPRINTS=
# Comma-separated SHA-256 fingerprints for the merchant Android app's
ANDROID_MERCHANT_CERT_SHA256_FINGERPRINTS=

# Google Analytics 4 (disabled when the public measurement ID is empty)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta browser tracking (disabled when the public Pixel ID is empty)
NEXT_PUBLIC_META_PIXEL_ID=
# Shared server-only HMAC secret; use the same value in the backend
META_CONTEXT_SIGNING_SECRET=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
